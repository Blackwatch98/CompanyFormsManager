    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\duczymin-logo-niebieskie.png">
