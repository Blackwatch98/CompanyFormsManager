<Window x:Class="CompanyFormsManager.Reports.InstallationContract"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Formularze" Width="1200" Height="800" Background="#f0f0f0">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Button Content="Generuj PDF"
                Click="PrintButton_Click"
                Height="48"
                Width="180"
                Margin="10"
                Padding="8"
                Style="{StaticResource MaterialDesignRaisedButton}"
                materialDesign:ButtonAssist.CornerRadius="8"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <FlowDocumentScrollViewer Width="Auto"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Center"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" >
                    <FlowDocument FontFamily="Arial" Name="MyDocument" Background="White" LineHeight="20" PageWidth="750">
                        <Section FontSize="14">
                            <Paragraph TextAlignment="Center">
                                <Image Source="pack://siteoforigin:,,/Resources/duczymin-logo-niebieskie.png"
                                       Height="100" Width="500"/>
                            </Paragraph>

                            <Paragraph Margin="0,100,0,0" TextAlignment="Center" FontSize="14" FontWeight="Bold">
                                <Span>UMOWA MONTAŻU nr</Span>
                                <Span>
                                    <TextBox Name="ContractNumberTextBox"
                                             Width="100"
                                             Height="20"
                                             Padding="1"
                                             MinHeight="20"
                                             Text="{Binding ElementName=ContractNumberInput, Path=Text}"
                                             materialDesign:HintAssist.Hint="Nr umowy"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Span>
                                <Span>/ 2025r.</Span>
                            </Paragraph>

                            <Paragraph>
                                Zawarta dnia
                                <TextBox Name="DealDateTextBox" Width="150"
                                         Text="{Binding ElementName=DealDateInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                w Rąbieniu, pomiędzy
                                <LineBreak/>
                                Zleceniodawcą:
                                <TextBox Name="CustomerNameTextBox" Width="200"
                                         Text="{Binding ElementName=CustomerNameInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                <LineBreak/>
                                Zamieszkałym:
                                <TextBox Name="CustomerAddressTextBox" Width="200"
                                         Text="{Binding ElementName=CustomerAddressInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                <LineBreak/>
                                NIP:
                                <TextBox Name="CustomerNIPTextBox" Width="100"
                                         Text="{Binding ElementName=CustomerNIPInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                , tel.:
                                <TextBox Name="CustomerPhoneNumberTextBox" Width="150"
                                         Text="{Binding ElementName=CustomerPhoneNumberInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                , email:
                                <TextBox Name="CustomerEmailTextBox" Width="200"
                                         Text="{Binding ElementName=CustomerEmailInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                , a Zleceniobiorcą: "DUCZYMIN" Halina Duczymińska, 95-070 Rąbień, ul. Słowiańska 92 na okoliczność montażu
                                <TextBox Name="CustomerEmailTextBox2" Width="200"
                                     Text="{Binding ElementName=CustomerEmailInput, Path=Text}"
                                     FontWeight="Bold" Height="16"/>
                                w budynku mieszkalnym położonym w
                                <TextBox Name="CustomerEmailTextBox3" Width="200"
                                     Text="{Binding ElementName=CustomerEmailInput, Path=Text}"
                                     FontWeight="Bold" Height="16"/>
                                przy ul.
                                <TextBox Name="CustomerEmailTextBox4" Width="200"
                                     Text="{Binding ElementName=CustomerEmailInput, Path=Text}"
                                     FontWeight="Bold" Height="16"/>
                            </Paragraph>

                            <Paragraph>
                                W ramach wykonywalnej usługi Zleceniobiorca zobowiązuje się dostarczyć Zleceniodawcę towar według załączonej specyfikacji:
                            </Paragraph>

                            <Paragraph>
                                <InlineUIContainer>
                                    <TextBox VerticalAlignment="Top" Height="200" Width="690" Margin="0" Padding="5"
                                             Background="#f0f0f0" BorderBrush="Gray" BorderThickness="1"
                                             Text="Treść specyfikacji..." Name="SpecificationTextBox"
                                             FontWeight="Bold" TextWrapping="Wrap" AcceptsReturn="True" HorizontalAlignment="Stretch"/>
                                </InlineUIContainer>
                            </Paragraph>

                            <Paragraph>
                                Zleceniobiorca zobowiązuje się do wykonania montażu, a Zleceniodawca do zapłaty brutto
                                <TextBox Name="PriceTextBox" Width="100"
                                         Text="{Binding ElementName=PriceInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                zł, słownie
                                <TextBox Name="PriceInWordsTextBox" Width="200"
                                         Text="{Binding ElementName=PriceInWordsInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                złotych za usługę montażu.
                            </Paragraph>

                            <Paragraph>
                                Na poczet tego zamówienia zostanie wpłacona zaliczka w wysokości
                                <TextBox Name="ZaliczkaTextBox" Width="100"
                                         Text="{Binding ElementName=ZaliczkaInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                zł słownie
                                <TextBox Name="ZaliczkaInWordsTextBox" Width="200"
                                         Text="{Binding ElementName=ZaliczkaInWordsInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                                złotych na poniższy rachunek bankowy Wykonawcy: "DUCZYMIN" Halina Duczymińska
                                <Run Name="BankAccountRun" Text="Numer bakonwy" FontWeight="Bold"/>
                            </Paragraph>

                            <Paragraph>
                                Termin płatności:
                                <TextBox Name="PaymentDueDateTextBox" Width="150"
                                         Text="{Binding ElementName=PaymentDueDateInput, Path=Text}"
                                         FontWeight="Bold" Height="16"/>
                            </Paragraph>

                            <Paragraph>
                                Dodatkowe uwagi:
                                <LineBreak/>
                                <InlineUIContainer>
                                    <TextBox VerticalAlignment="Top" Height="150" Width="690" Margin="0" Padding="5"
                                             Background="#f0f0f0" BorderBrush="Gray" BorderThickness="1"
                                             Text="Dodatkowe uwagi dotyczące montażu..." Name="AdditionalNotesTextBox"
                                             FontWeight="Bold" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </InlineUIContainer>
                            </Paragraph>
                        </Section>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

